# Copy to .env and fill in what you use. Everything is optional; the app works offline-ish without any of it
# (real shorelines/elevation need outbound HTTPS; Gemini needs a key).

# Server port (probes upward if busy)
PORT=3000

# --- Gemini (optional) -------------------------------------------------------
# Enables: AI depth/survey recon with Google Search grounding, uploaded-chart analysis.
# Get a key at https://aistudio.google.com/apikey . Leave unset to run without AI.
GEMINI_API_KEY=
# Model IDs rotate; override if Google retires a default. Defaults: gemini-3.5-flash / gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_LITE_MODEL=gemini-3.1-flash-lite

# --- Real geodata (on by default) --------------------------------------------
# Shoreline polygons come from Nominatim (OpenStreetMap), elevation from Terrarium tiles on AWS Open Data.
# GEODATA_DISABLED=true            # force the offline curated/procedural models
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# TERRAIN_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# GEODATA_USER_AGENT=lake-topo-3d/1.0 (you@example.com)   # Nominatim asks for a contact in the UA

# APP_URL is injected by AI Studio when hosted there; unused locally.
# APP_URL=

# ---- server
PORT=3000

# ---- optional LLM enrichment (geology sentence, landmarks, a depth when no record exists)
# Provider: none | anthropic | openai | openrouter | ollama | lmstudio | venice | gemini | custom
# Leave unset to auto-detect from whichever key below is present.
LLM_PROVIDER=
LLM_MODEL=            # override the provider default (e.g. claude-opus-5, gpt-5, llama3.1, google/gemini-3.5-flash)
LLM_VISION_MODEL=     # model used to read uploaded chart images (defaults to LLM_MODEL / provider default)
LLM_BASE_URL=         # OpenAI-compatible base, e.g. http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio)
LLM_API_KEY=          # generic key override

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
VENICE_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
LMSTUDIO_BASE_URL=

# ---- data sources (all free, no keys)
GEODATA_DISABLED=false      # true = fully offline (procedural / hand-built models only)
DEM_SOURCE=auto             # auto | 3dep | terrarium
IDNR_DISABLED=false         # Indiana DNR sonar contours + depth-map PDFs
WIKI_DISABLED=false         # Wikipedia / Wikidata facts
GEODATA_USER_AGENT=lake-topo-3d/1.0 (you@example.com)   # Nominatim asks for a contact
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
TERRAIN_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
LAKE_CACHE_DIR=.cache       # disk cache for shoreline / survey / wiki lookups
